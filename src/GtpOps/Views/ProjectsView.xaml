<UserControl x:Class="GtpOps.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Proyectos — GameTechnology Portal" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Foreground="#757575" Margin="0,4,0,0"
                       Text="Elegí un juego (catálogo o gameId) para ver sus proyectos y releases. Datos vía compass CLI." />
        </StackPanel>

        <!-- Game picker -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="Juego:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox DockPanel.Dock="Left" Width="320" Padding="6,5"
                          ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                          IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName"
                          DisplayMemberPath="DisplayName" />
                <TextBlock DockPanel.Dock="Left" Text="o gameId:" VerticalAlignment="Center" Margin="16,0,8,0" />
                <TextBox DockPanel.Dock="Left" Width="90" Padding="6,5" VerticalContentAlignment="Center"
                         Text="{Binding ManualGameId, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Para juegos que no estén en el catálogo (gameId canónico de Portal)" />
                <Button DockPanel.Dock="Left" Content="Cargar proyectos" Padding="12,6" Margin="16,0,0,0"
                        FontWeight="SemiBold" Command="{Binding LoadProjectsCommand}" />
                <Button DockPanel.Dock="Left" Content="📖 Helpfiles" Padding="12,6" Margin="8,0,0,0"
                        FontWeight="SemiBold" Background="#00695C" Foreground="White"
                        ToolTip="Validar los helpfiles del juego (a nivel juego, no proyecto)"
                        Command="{Binding ValidateHelpfilesCommand}" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#757575"
                           Text="{Binding StatusMessage}" />
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0" Margin="0,10,0,0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Projects list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Margin="14,10,14,0"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Width="70" Binding="{Binding Id}" />
                            <DataGridTextColumn Header="Proyecto" Width="*" Binding="{Binding ProjectName}" />
                            <DataGridTextColumn Header="Tipo" Width="110" Binding="{Binding ProjectType}" />
                            <DataGridTextColumn Header="Estado" Width="100" Binding="{Binding ProjectStatus}" />
                            <DataGridTextColumn Header="Creado" Width="95"
                                                Binding="{Binding CreatedOn, StringFormat='yyyy-MM-dd'}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Project detail + releases -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Text="{Binding SelectedProject.ProjectName, TargetNullValue='Seleccioná un proyecto'}" />
                            <Button DockPanel.Dock="Right" Content="🔍 Deliverables" Padding="12,6"
                                    FontWeight="SemiBold" Background="#1565C0" Foreground="White"
                                    Command="{Binding ValidateDeliverablesCommand}" />
                            <Button DockPanel.Dock="Right" Content="🏅 Pre-certificación" Padding="12,6" Margin="0,0,8,0"
                                    FontWeight="SemiBold" Background="#6A1B9A" Foreground="White"
                                    Command="{Binding PreCertificationCommand}" />
                        </DockPanel>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <TextBlock Foreground="#757575" FontSize="12">
                                <Run Text="Tipo:" /> <Run Text="{Binding SelectedProject.ProjectType, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="  ·  Sub:" /> <Run Text="{Binding SelectedProject.ProjectSubType, Mode=OneWay, TargetNullValue='—'}" />
                            </TextBlock>
                            <TextBlock Foreground="#757575" FontSize="12">
                                <Run Text="Estado:" /> <Run Text="{Binding SelectedProject.ProjectStatus, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Foreground="#757575" FontSize="12">
                                <Run Text="Jira:" /> <Run Text="{Binding SelectedProject.JiraIssueKey, Mode=OneWay, TargetNullValue='—'}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Foreground="#757575" FontSize="12">
                                <Run Text="Creado por:" /> <Run Text="{Binding SelectedProject.CreatedBy.Name, Mode=OneWay, TargetNullValue='—'}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Foreground="#757575" FontSize="12">
                                <Run Text="Orden:" /> <Run Text="{Binding SelectedProject.GameOrder.OrderName, Mode=OneWay, TargetNullValue='—'}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Foreground="#757575" FontSize="12" TextWrapping="Wrap">
                                <Run Text="Participantes:" /> <Run Text="{Binding ProjectParticipants, Mode=OneWay}" />
                            </TextBlock>
                        </UniformGrid>
                        <TextBlock Foreground="#616161" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="{Binding SelectedProject.Notes, TargetNullValue=''}"
                                   Visibility="{Binding SelectedProject.Notes, Converter={StaticResource NullOrEmptyToVisibility}}" />

                        <DockPanel Margin="0,12,0,4" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Releases" FontWeight="SemiBold" />
                            <ProgressBar DockPanel.Dock="Right" Width="70" Height="4" IsIndeterminate="True"
                                         BorderThickness="0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoadingReleases, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding Releases}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Release" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="TC" Width="45" Binding="{Binding TestCycle}" />
                            <DataGridTextColumn Header="Estado" Width="90" Binding="{Binding ReleaseStatus}" />
                            <DataGridTextColumn Header="Enviado" Width="95"
                                                Binding="{Binding DateSubmitted, StringFormat='yyyy-MM-dd'}" />
                            <DataGridTextColumn Header="Jira" Width="110" Binding="{Binding JiraIssueKey}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
