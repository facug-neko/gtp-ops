<UserControl x:Class="GtpOps.Views.HelpfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One expandable helpfile: header verdict + checklist -->
        <DataTemplate x:Key="HelpfileTemplate">
            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,2">
                <!-- Mode=OneWay is required: IsExpanded binds TwoWay by default and
                     IsReleasable is a read-only computed property (TwoWay would throw). -->
                <Expander IsExpanded="{Binding IsReleasable, Converter={StaticResource InverseBool}, Mode=OneWay}">
                    <Expander.Header>
                        <DockPanel LastChildFill="False" Margin="4,6,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="●" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="15"
                                       Foreground="{Binding IsReleasable, Converter={StaticResource HealthToBrush}}" />
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14">
                                <Run Text="{Binding Helpfile.PayoutVariant, Mode=OneWay}" />
                                <Run Text="·  v" /><Run Text="{Binding Helpfile.Version, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="✗ Con problemas" />
                                        <Setter Property="Foreground" Value="#C62828" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReleasable}" Value="True">
                                                <Setter Property="Text" Value="✔ Listo para release" />
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel Margin="34,4,10,10">
                        <ItemsControl ItemsSource="{Binding Checks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <TextBlock DockPanel.Dock="Left" Text="●" Margin="0,0,8,0" VerticalAlignment="Top"
                                                   Foreground="{Binding Passed, Converter={StaticResource HealthToBrush}}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" />
                                            <TextBlock Text="{Binding Detail}" Foreground="#C62828" FontSize="12"
                                                       Visibility="{Binding Detail, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Drill-down: the exact phrases behind the content checks. -->
                        <Border Margin="0,12,0,0" Padding="10,8" Background="#FAFAFA" CornerRadius="4"
                                Visibility="{Binding HasContentIssues, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Frases observadas" FontWeight="SemiBold" FontSize="12" Foreground="#616161" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ContentIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,7">
                                                <TextBlock Text="{Binding Caption}" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#9E9E9E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBlocking}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C62828" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Validación de Helpfiles" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Foreground="#757575" Margin="0,4,0,0">
                    <Run Text="Juego:" /> <Run Text="{Binding GameName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  ·  id" /> <Run Text="{Binding GameId, Mode=OneWay}" />
                    <Run Text="  ·  último helpfile por variante" />
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="⟳ Revalidar" Padding="12,6" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                <Button Content="← Volver a proyectos" Padding="12,6" Command="{Binding BackCommand}" />
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Headline -->
        <Border Grid.Row="2" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                Visibility="{Binding Headline, Converter={StaticResource NullOrEmptyToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FDECEA" />
                    <Setter Property="BorderBrush" Value="#F5C6CB" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllReleasable}" Value="True">
                            <Setter Property="Background" Value="#E8F5E9" />
                            <Setter Property="BorderBrush" Value="#C8E6C9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        </Border>

        <!-- Content -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Margin="14,10,14,0"
                           Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                <TextBlock DockPanel.Dock="Top" Foreground="#757575" FontSize="12" Margin="14,10,14,4"
                           Text="{Binding StatusMessage}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Reports}" ItemTemplate="{StaticResource HelpfileTemplate}" Margin="6" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
