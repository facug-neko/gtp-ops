<UserControl x:Class="GtpOps.Views.DeliverablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One expandable deliverable: header summary + variant×market coverage -->
        <DataTemplate x:Key="DeliverableTemplate">
            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="0,2">
                <Expander>
                    <Expander.Header>
                        <DockPanel LastChildFill="False" Margin="4,4,0,4">
                            <TextBlock DockPanel.Dock="Left" Text="●" Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{Binding IsMet, Converter={StaticResource HealthToBrush}}" />
                            <TextBlock DockPanel.Dock="Left" Text="{Binding DeliverableType}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Left" Background="#ECEFF1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="⚙ auto" FontSize="11" Foreground="#546E7A"
                                           Visibility="{Binding CanAutoGenerate, Converter={StaticResource BoolToVisibility}}" />
                            </Border>
                            <!-- Backend tag toggle: command lives on the VM (UserControl DataContext) -->
                            <Button DockPanel.Dock="Right" Padding="8,2" Margin="10,0,0,0" FontSize="11"
                                    Command="{Binding DataContext.ToggleBackendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Content" Value="☆ Mío" />
                                        <Setter Property="ToolTip" Value="Marcar como mi responsabilidad" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBackend}" Value="True">
                                                <Setter Property="Content" Value="★ Mío" />
                                                <Setter Property="Background" Value="#6A1B9A" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="ToolTip" Value="Quitar de mis responsabilidades" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Discard / restore: command lives on the VM (UserControl DataContext) -->
                            <Button DockPanel.Dock="Right" Content="Descartar" Padding="8,2" Margin="10,0,0,0" FontSize="11"
                                    ToolTip="Marcar como no-obligatorio para nosotros (en este estudio)"
                                    Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsDiscarded, Converter={StaticResource InverseBoolToVisibility}}" />
                            <Button DockPanel.Dock="Right" Content="Restaurar" Padding="8,2" Margin="10,0,0,0" FontSize="11"
                                    ToolTip="Volver a la regla de GTP"
                                    Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsDiscarded, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#9E9E9E" FontSize="12">
                                <Run Text="{Binding FileCount, Mode=OneWay}" /> <Run Text="archivo(s)" />
                            </TextBlock>
                        </DockPanel>
                    </Expander.Header>
                    <Grid Margin="30,4,10,10">
                        <!-- General deliverable (no per-market requirements) -->
                        <TextBlock Foreground="#757575" FontSize="12"
                                   Text="General — sin requisitos por mercado. Basta con cargar el archivo.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMarketCoverage}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Per-market coverage grid -->
                        <DataGrid ItemsSource="{Binding Coverage}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  BorderThickness="0" GridLinesVisibility="Horizontal" MaxHeight="300"
                                  HorizontalGridLinesBrush="#F0F0F0" Background="Transparent" RowBackground="Transparent"
                                  Visibility="{Binding HasMarketCoverage, Converter={StaticResource BoolToVisibility}}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="●" HorizontalAlignment="Center"
                                                       Foreground="{Binding IsMet, Converter={StaticResource HealthToBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Variante" Width="90" Binding="{Binding Variant}" />
                                <DataGridTextColumn Header="Mercado" Width="*" Binding="{Binding Market}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Validación de deliverables (V2)" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Foreground="#757575" Margin="0,4,0,0">
                    <Run Text="Proyecto:" /> <Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  ·  id" /> <Run Text="{Binding ProjectId, Mode=OneWay}" />
                    <Run Text="  ·  reglas de" /> <Run Text="{Binding Scope, Mode=OneWay}" FontWeight="SemiBold" Foreground="#6A1B9A" />
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="⟳ Revalidar" Padding="12,6" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                <Button Content="← Volver a proyectos" Padding="12,6" Command="{Binding BackCommand}" />
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Headline -->
        <Border Grid.Row="2" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                Visibility="{Binding Headline, Converter={StaticResource NullOrEmptyToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FDECEA" />
                    <Setter Property="BorderBrush" Value="#F5C6CB" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllRequiredMet}" Value="True">
                            <Setter Property="Background" Value="#E8F5E9" />
                            <Setter Property="BorderBrush" Value="#C8E6C9" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasNoDeliverables}" Value="True">
                            <Setter Property="Background" Value="#F5F5F5" />
                            <Setter Property="BorderBrush" Value="#E0E0E0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        </Border>

        <!-- Stepper -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding Stages}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="40,4" HorizontalAlignment="Center">
                            <Ellipse Width="34" Height="34" HorizontalAlignment="Center"
                                     Fill="{Binding IsComplete, Converter={StaticResource HealthToBrush}}" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Detail}" Foreground="#757575" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <!-- No V2 deliverables at all (empty array) -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding HasNoDeliverables, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Margin="0,20" HorizontalAlignment="Center">
                    <TextBlock Text="📭" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#757575" Margin="0,10,0,0"
                               TextWrapping="Wrap" HorizontalAlignment="Center" MaxWidth="520" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Sections -->
            <Border Style="{StaticResource Card}" Padding="6"
                    Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}">
                <TabControl BorderThickness="0" Background="Transparent">
                    <TabItem Header="{Binding BackendTabHeader}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" CornerRadius="6" Padding="12,8" Margin="4,8,4,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F3E5F5" />
                                        <Setter Property="BorderBrush" Value="#E1BEE7" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BackendAllDone}" Value="True">
                                                <Setter Property="Background" Value="#E8F5E9" />
                                                <Setter Property="BorderBrush" Value="#C8E6C9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding BackendSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Backend}" ItemTemplate="{StaticResource DeliverableTemplate}"
                                              Margin="4,4,4,4" />
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{Binding AllTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding All}" ItemTemplate="{StaticResource DeliverableTemplate}"
                                          Margin="4,8,4,4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding MissingTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding MissingRequired}" ItemTemplate="{StaticResource DeliverableTemplate}"
                                          Margin="4,8,4,4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding LoadedTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Loaded}" ItemTemplate="{StaticResource DeliverableTemplate}"
                                          Margin="4,8,4,4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding OptionalTabHeader}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OptionalPending}" ItemTemplate="{StaticResource DeliverableTemplate}"
                                          Margin="4,8,4,4" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding DiscardedTabHeader}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Foreground="#757575" FontSize="12" Margin="8,8,8,4" TextWrapping="Wrap"
                                       Text="Tipos marcados como no-obligatorios para este estudio. No cuentan como faltantes. Podés restaurarlos." />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Discarded}" ItemTemplate="{StaticResource DeliverableTemplate}"
                                              Margin="4,4,4,4" />
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
