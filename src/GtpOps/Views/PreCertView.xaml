<UserControl x:Class="GtpOps.Views.PreCertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Pre-certificación" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Foreground="#757575" Margin="0,4,0,0">
                    <Run Text="Proyecto:" /> <Run Text="{Binding ProjectName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  ·  id" /> <Run Text="{Binding ProjectId, Mode=OneWay}" />
                    <Run Text="  ·  estado de certificación por mercado × variante" />
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="⟳ Reconsultar" Padding="12,6" Margin="0,0,8,0" Command="{Binding RefreshCommand}" />
                <Button Content="← Volver a proyectos" Padding="12,6" Command="{Binding BackCommand}" />
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Headline -->
        <Border Grid.Row="2" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                Visibility="{Binding Headline, Converter={StaticResource NullOrEmptyToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FDECEA" />
                    <Setter Property="BorderBrush" Value="#F5C6CB" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AllReady}" Value="True">
                            <Setter Property="Background" Value="#E8F5E9" />
                            <Setter Property="BorderBrush" Value="#C8E6C9" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="Solo los que requieren certificación" VerticalAlignment="Center"
                      IsChecked="{Binding OnlyRequiringCertification}" />
            <TextBlock DockPanel.Dock="Left" Margin="16,0,0,0" Foreground="#757575" VerticalAlignment="Center"
                       Text="{Binding StatusMessage}" />
        </DockPanel>

        <!-- Grid -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Margin="14,10,14,0"
                           Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                <DataGrid ItemsSource="{Binding Rows}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                          EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="34">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="●" HorizontalAlignment="Center"
                                               Foreground="{Binding IsReady, Converter={StaticResource HealthToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mercado" Width="2*" Binding="{Binding Market}" />
                        <DataGridTextColumn Header="Cód." Width="70" Binding="{Binding MarketCode}" />
                        <DataGridTextColumn Header="Variante" Width="80" Binding="{Binding Variant}" />
                        <DataGridTextColumn Header="Decisión" Width="150" Binding="{Binding Decision}">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RequiresCertification}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Características" Width="3*" Binding="{Binding Characteristics}" />
                        <DataGridTextColumn Header="Ver. actual" Width="100" Binding="{Binding CurrentVersion}" />
                        <DataGridTextColumn Header="Ver. activa" Width="100" Binding="{Binding ActiveVersion}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
