<Window x:Class="AxiomOps.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AxiomOps.UI.ViewModels"
        xmlns:views="clr-namespace:AxiomOps.UI.Views"
        Title="AxiomOps" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F5F5">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:EnvironmentSelectorViewModel}">
            <views:EnvironmentSelectorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BulkBetSettingsViewModel}">
            <views:BulkBetSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersViewModel}">
            <views:UsersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamesViewModel}">
            <views:GamesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LaunchViewModel}">
            <views:LaunchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilesViewModel}">
            <views:FilesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TestDataViewModel}">
            <views:TestDataView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GameEventDataViewModel}">
            <views:GameEventDataView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CreateUserViewModel}">
            <views:CreateUserView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeployGameViewModel}">
            <views:DeployGameView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayRepositoryViewModel}">
            <views:PlayRepositoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FreeGamesViewModel}">
            <views:FreeGamesView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentViewModel}" />
</Window>
