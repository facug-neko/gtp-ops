<UserControl x:Class="AxiomOps.UI.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One diagnostic row: green/red dot + value + label (like the portal modal) -->
        <DataTemplate x:Key="CheckRow">
            <DockPanel Margin="0,5,0,5">
                <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top"
                         Fill="{Binding Passed, Converter={StaticResource HealthToBrush}}" />
                <StackPanel>
                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Label}" Foreground="#757575" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold">
                    <Run Text="Juegos —" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="#757575" Margin="0,4,0,0"
                           Text="Diagnóstico de instalación por juego: base de datos, archivos del servicio y dependencias." />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="⟳ Reanalizar" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <Button Content="← Volver al dashboard" Padding="12,6"
                        Command="{Binding BackCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Alert banner -->
        <Border Grid.Row="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                Background="#FDECEA" BorderBrush="#F5C6CB" BorderThickness="1"
                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="#C62828" FontWeight="SemiBold">
                <Run Text="⚠" /> <Run Text="{Binding ProblemCount, Mode=OneWay}" />
                <Run Text="juego(s) con problemas de instalación — revisá los marcados en rojo." />
            </TextBlock>
        </Border>
        <Border Grid.Row="2" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1"
                Visibility="{Binding AllHealthy, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Foreground="#2E7D32" FontWeight="SemiBold"
                       Text="✔ Todos los juegos están correctamente instalados." />
        </Border>

        <!-- Toolbar -->
        <DockPanel Grid.Row="3" Margin="0,0,0,10" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="300" Padding="6,5" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtrar por nombre, moduleId, clientId o provider" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#757575"
                       Text="{Binding StatusMessage}" />
            <ProgressBar DockPanel.Dock="Right" Width="120" Height="4" IsIndeterminate="True" BorderThickness="0"
                         VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- Games list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Margin="14,10,14,0"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Estado" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="13" Height="13" HorizontalAlignment="Center"
                                                 Fill="{Binding IsHealthy, Converter={StaticResource HealthToBrush}}"
                                                 ToolTip="{Binding FailedCount, StringFormat={}{0} chequeo(s) fallido(s)}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Header="Módulo" Width="85" Binding="{Binding ModuleId}" />
                            <DataGridTextColumn Header="Cliente" Width="85" Binding="{Binding ClientId}" />
                            <DataGridTextColumn Header="Provider" Width="120" Binding="{Binding GameProvider}" />
                            <DataGridTextColumn Header="Fallas" Width="70" Binding="{Binding FailedCount}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Troubleshoot detail -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Troubleshoot Install" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Text="{Binding SelectedGame.DisplayName, TargetNullValue='Seleccioná un juego'}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Database" Foreground="#757575" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedGame.DatabaseChecks}"
                                          ItemTemplate="{StaticResource CheckRow}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Services" Foreground="#757575" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedGame.FileChecks}"
                                          ItemTemplate="{StaticResource CheckRow}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Dependencias" Foreground="#757575" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding SelectedGame.DependencyChecks}"
                                          ItemTemplate="{StaticResource CheckRow}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
