<UserControl x:Class="AxiomOps.UI.Views.CreateUserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Crear usuario" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Foreground="#757575" Margin="0,4,0,0"
                           Text="Rápido (solo el nombre), completo, o junto con su testdata." />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="← Volver a usuarios" Padding="12,6" VerticalAlignment="Top"
                    Command="{Binding BackCommand}" />
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TabControl Grid.Row="2" Margin="0,10,0,0" BorderThickness="0" Background="Transparent">

            <!-- Quick -->
            <TabItem Header="Rápido">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" VerticalAlignment="Top">
                    <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                        <TextBlock Text="Creación rápida" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
                        <TextBlock Foreground="#757575" TextWrapping="Wrap" Margin="0,0,0,12"
                                   Text="Solo el nombre. Se usan: Market DEF · Product 5001 (Island Paradise) · Country Argentina · Currency USD · Real Player · password test1234$" />

                        <TextBlock Style="{StaticResource CardTitle}" Text="Nombre de usuario" />
                        <TextBox Padding="6,5" FontFamily="Consolas"
                                 Text="{Binding QuickUsername, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,4,0,12" FontSize="12" Text="{Binding QuickNameStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2E7D32" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QuickNameStatus}" Value="✘ Ya existe un usuario con ese nombre">
                                            <Setter Property="Foreground" Value="#C62828" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Content="Crear usuario" Padding="0,9" FontWeight="SemiBold"
                                Background="#2E7D32" Foreground="White"
                                Command="{Binding QuickCreateCommand}" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- Full form -->
            <TabItem Header="Completo">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" VerticalAlignment="Top">
                    <Grid MaxWidth="900" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Player Type" />
                            <ComboBox ItemsSource="{Binding UserTypes}" SelectedItem="{Binding SelectedUserType}"
                                      DisplayMemberPath="Description" Padding="6,5" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource CardTitle}" Text="Market" />
                            <ComboBox ItemsSource="{Binding Markets}" SelectedItem="{Binding SelectedMarket}"
                                      Padding="6,5" Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding MarketType, Mode=OneWay}" />
                                            <Run Text="{Binding FriendlyName, Mode=OneWay}" Foreground="#757575" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Style="{StaticResource CardTitle}" Text="Product" />
                            <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                      Padding="6,5" Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding CasinoName, Mode=OneWay}" />
                                            <Run Text="{Binding ServerId, Mode=OneWay, StringFormat=({0})}" Foreground="#757575" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Style="{StaticResource CardTitle}" Text="Nombre de usuario" />
                            <TextBox Padding="6,5" FontFamily="Consolas"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,4,0,10" FontSize="12" Text="{Binding UsernameStatus}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UsernameStatus}" Value="✘ Ya existe un usuario con ese nombre">
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding UsernameStatus}" Value="Se usará como prefijo de las cuentas">
                                                <Setter Property="Foreground" Value="#757575" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Style="{StaticResource CardTitle}" Text="Password" />
                            <TextBox Padding="6,5" FontFamily="Consolas"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource CardTitle}" Text="Country" />
                            <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}"
                                      DisplayMemberPath="Name" Padding="6,5" Margin="0,0,0,10"
                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" />

                            <TextBlock Style="{StaticResource CardTitle}" Text="Currency" />
                            <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}"
                                      DisplayMemberPath="IsoCode" Padding="6,5" Margin="0,0,0,10"
                                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="IsoCode" />

                            <CheckBox Content="Crear múltiples cuentas (bulk)" Margin="0,6,0,8"
                                      IsChecked="{Binding BulkCreate}" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Cantidad de cuentas" />
                            <TextBox Padding="6,5" Margin="0,0,0,16" IsEnabled="{Binding BulkCreate}"
                                     Text="{Binding NumberOfAccounts, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Content="Crear cuenta" Padding="0,9" FontWeight="SemiBold"
                                    Background="#2E7D32" Foreground="White"
                                    Command="{Binding CreateCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </TabItem>

            <!-- User + testdata -->
            <TabItem Header="Usuario + TestData">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Usuario + testdata" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />

                            <TextBlock Style="{StaticResource CardTitle}" Text="Nombre de usuario" />
                            <TextBox Padding="6,5" FontFamily="Consolas"
                                     Text="{Binding TestDataUsername, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,4,0,12" FontSize="12" Text="{Binding TestDataNameStatus}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2E7D32" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestDataNameStatus}" Value="✘ Ya existe un usuario con ese nombre">
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Content="📂 Cargar testdata desde archivo" Padding="0,7" Margin="0,0,0,12"
                                    Command="{Binding LoadTestDataFileCommand}" />

                            <TextBlock Style="{StaticResource CardTitle}" Text="Nombre del archivo a subir" />
                            <TextBox Padding="6,5" FontFamily="Consolas" Margin="0,0,0,12"
                                     Text="{Binding TestDataFileName, UpdateSourceTrigger=PropertyChanged}" />

                            <Border Background="#F5F5F5" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="#616161">
                                        <Run Text="moduleID:" /><Run Text="{Binding TestDataModuleId, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                                        <Run Text="   clientId:" /><Run Text="{Binding TestDataClientId, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#616161" Margin="0,4,0,0">
                                        <Run Text="loginName en el XML:" /><Run Text="{Binding TestDataLoginName, Mode=OneWay, TargetNullValue=—}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="#1565C0" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding LoginNameWillChange, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="⟳ Se reemplazará el loginName por" /><Run Text="{Binding TestDataUsername, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Button Content="Crear usuario y subir testdata" Padding="0,9" FontWeight="SemiBold"
                                    Background="#2E7D32" Foreground="White"
                                    Command="{Binding CreateWithTestDataCommand}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Contenido del testdata (editable)"
                                       FontWeight="SemiBold" Margin="14,12,14,6" />
                            <TextBox Text="{Binding TestDataContent, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Consolas" FontSize="12"
                                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Padding="8" Background="#FAFAFA" BorderThickness="0" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <StackPanel Grid.Row="3" Margin="2,12,0,0">
            <TextBlock Foreground="#2E7D32" TextWrapping="Wrap"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
            <TextBlock Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
