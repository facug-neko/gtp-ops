<UserControl x:Class="AxiomOps.UI.Views.PlayRepositoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Repositorio de jugadas" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Foreground="#757575" Margin="0,4,0,0">
                    <Run Text="Ambiente:" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  ·  links de launch pre-armados a partir de los testdata de un juego" />
                </TextBlock>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="← Volver" Padding="12,6" Command="{Binding BackCommand}" />
        </DockPanel>

        <!-- Controls -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Juego:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="280" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                    <Run Foreground="#757575">
                                        <Run.Text>
                                            <MultiBinding StringFormat="  [{0}/{1}]" Mode="OneWay">
                                                <Binding Path="ModuleId" Mode="OneWay" />
                                                <Binding Path="ClientId" Mode="OneWay" />
                                            </MultiBinding>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Versión:" VerticalAlignment="Center" Margin="14,0,8,0" />
                    <ComboBox Width="100" ItemsSource="{Binding GameVersions}" SelectedItem="{Binding SelectedGameVersion}"
                              VerticalContentAlignment="Center" ToolTip="Versión del cliente del juego a usar en los links generados" />
                    <TextBlock Text="Mercado:" VerticalAlignment="Center" Margin="20,0,8,0" />
                    <ComboBox Width="150" ItemsSource="{Binding Lobbies}" SelectedItem="{Binding SelectedLobby}"
                              DisplayMemberPath="FriendlyName" VerticalContentAlignment="Center" />
                    <CheckBox Content="Solo listos" IsChecked="{Binding ShowOnlyReady}"
                              VerticalAlignment="Center" Margin="20,0,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📤 Exportar CSV" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding ExportCsvCommand}" />
                    <Button Content="⚙ Generar" Padding="14,6" FontWeight="SemiBold"
                            Background="#1565C0" Foreground="White"
                            Command="{Binding GenerateCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0" Margin="0,0,0,4"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Style="{StaticResource ErrorText}"
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
            <TextBlock Foreground="#757575" FontSize="12"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
            <TextBlock Foreground="#757575" FontSize="12" Margin="0,2,0,0"
                       Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <Run Text="{Binding ReadyCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="de" />
                <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" />
                <Run Text="testdata(s) con link listo" />
            </TextBlock>
        </StackPanel>

        <!-- Results -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Estado" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2" ToolTip="{Binding Detail}">
                                    <TextBlock Text="●" Margin="0,0,6,0"
                                               Foreground="{Binding StatusFlag, Converter={StaticResource HealthToBrush}}" />
                                    <TextBlock Text="{Binding StatusLabel}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Juego" Width="*" Binding="{Binding GameDisplayName}" />
                    <DataGridTextColumn Header="TestData" Width="170" Binding="{Binding TestDataFile}" />
                    <DataGridTextColumn Header="LoginName" Width="100" Binding="{Binding LoginName}" />
                    <DataGridTextColumn Header="Prize" Width="110" Binding="{Binding Prize}" />
                    <DataGridTextColumn Header="Description" Width="160" Binding="{Binding Description}" />
                    <DataGridTextColumn Header="Host" Width="70" Binding="{Binding Host}" />
                    <DataGridTextColumn Header="Mercado" Width="90" Binding="{Binding Market}" />
                    <DataGridTextColumn Header="Versión" Width="80" Binding="{Binding GameVersion}" />
                    <DataGridTemplateColumn Header="URL" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Url}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Url}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="⧉ Copiar" Padding="8,3"
                                        Command="{Binding DataContext.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding Url, Converter={StaticResource NullOrEmptyToVisibility}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
