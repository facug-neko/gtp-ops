<UserControl x:Class="AxiomOps.UI.Views.BulkBetSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold">
                    <Run Text="Bet settings masivos —" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="#757575" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Aplica un valor de bet setting a todos los usuarios del ambiente para un juego (equivale a Fetch + Apply Settings de la pestaña Static Bet Settings, usuario por usuario)." />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="← Volver al dashboard" Padding="12,6" VerticalAlignment="Top"
                    Command="{Binding BackCommand}" />
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" BorderThickness="0">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBusy}" Value="True" />
                                <Condition Binding="{Binding IsApplying}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>

        <!-- Configuration -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Game -->
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Juego (moduleId / clientId)" />
                    <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Padding="6,5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                    <Run Foreground="#757575">
                                        <Run.Text>
                                            <MultiBinding StringFormat="  [{0}/{1}]" Mode="OneWay">
                                                <Binding Path="ModuleId" Mode="OneWay" />
                                                <Binding Path="ClientId" Mode="OneWay" />
                                            </MultiBinding>
                                        </Run.Text>
                                    </Run>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Cargar settings del juego" Margin="0,8,0,0" Padding="10,5" HorizontalAlignment="Left"
                            Command="{Binding LoadSettingsCommand}" />
                </StackPanel>

                <!-- Setting -->
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Bet setting" />
                    <ComboBox ItemsSource="{Binding Settings}" SelectedItem="{Binding SelectedSetting}" Padding="6,5" />
                    <TextBlock Margin="0,8,0,0" Foreground="#757575" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding SelectedSetting.Description, TargetNullValue='Seleccioná un juego y cargá sus settings.'}" />
                </StackPanel>

                <!-- Value -->
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource CardTitle}">
                        <Run Text="Nuevo valor" />
                        <Run Text="{Binding SelectedSetting.DataTypeLabel, Mode=OneWay, StringFormat=({0})}" Foreground="#9E9E9E" />
                    </TextBlock>
                    <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" FontFamily="Consolas" />
                    <TextBlock Style="{StaticResource CardTitle}" Text="Filtro loginName (opcional)" Margin="0,10,0,4" />
                    <TextBox Text="{Binding LoginFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6,5"
                             ToolTip="Si se completa, solo se aplica a los usuarios cuyo loginName contenga este texto." />
                </StackPanel>

                <!-- Action -->
                <StackPanel Grid.Column="6" VerticalAlignment="Center" MinWidth="170">
                    <TextBlock HorizontalAlignment="Center" Foreground="#757575" Margin="0,0,0,6">
                        <Run Text="{Binding TotalUsers, Mode=OneWay}" /> <Run Text="usuarios" />
                    </TextBlock>
                    <Button Content="Aplicar a todos" Padding="0,10" FontWeight="SemiBold"
                            Background="#1565C0" Foreground="White"
                            Command="{Binding ApplyToAllCommand}" />
                    <Button Content="Cancelar" Padding="0,6" Margin="0,8,0,0"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress + results -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Style="{StaticResource ErrorText}" Margin="0,4,0,0"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <ProgressBar Height="14" Margin="0,8,0,0"
                                 Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Log}" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
