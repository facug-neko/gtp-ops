<UserControl x:Class="AxiomOps.UI.Views.TestDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold">
                    <Run Text="TestData —" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="#757575" Margin="0,4,0,0"
                           Text="{Binding TestDataFolder, StringFormat='Carpeta: {0}'}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="✓ Validar coherencia" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold"
                        Background="#1565C0" Foreground="White"
                        ToolTip="Detecta testdatas con la misma identidad (moduleID [+ clientId] + loginName)"
                        Command="{Binding ValidateCommand}" />
                <Button Content="⬆ Subir archivo(s)" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold"
                        Command="{Binding UploadFilesCommand}" />
                <Button Content="⟳ Actualizar" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <Button Content="← Volver" Padding="12,6"
                        Command="{Binding BackCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="280" Padding="6,5" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtrar por nombre o moduleId" />
            <CheckBox DockPanel.Dock="Left" Content="Solo conflictos" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding ShowOnlyConflicts}" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#757575"
                       Text="{Binding StatusMessage}" />
        </DockPanel>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                          EnableRowVirtualization="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding ConflictDetail}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Validation}" Value="Duplicate">
                                    <Setter Property="Background" Value="#FDECEA" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Validation}" Value="Invalid">
                                    <Setter Property="Background" Value="#FFF8E1" />
                                    <Setter Property="Foreground" Value="#EF6C00" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Width="Auto" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Módulo" Width="70" Binding="{Binding ModuleId}" />
                        <DataGridTextColumn Header="Identidad (Key)" Width="*" Binding="{Binding KeyInfo}" />
                        <DataGridTextColumn Header="Modificado" Width="120"
                                            Binding="{Binding DateModified, StringFormat='yyyy-MM-dd HH:mm'}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detail / editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                   Text="{Binding SelectedFile.Name, TargetNullValue='Seleccioná un testdata para ver su contenido'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="💾 Guardar cambios" Padding="10,5" FontWeight="SemiBold"
                                    Background="#2E7D32" Foreground="White"
                                    Command="{Binding SaveFileCommand}" />
                            <Button Content="🗑 Eliminar" Padding="10,5" Margin="8,0,0,0"
                                    Command="{Binding DeleteFileCommand}" />
                        </StackPanel>

                        <!-- Prize/Description for the QA play repository — stored as a
                             trailing comment outside <Test>, not part of the game payload. -->
                        <Border Background="#F5F5F5" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Resumen para el repositorio de jugadas" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="6" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Prize" VerticalAlignment="Center" Width="70" />
                                    <TextBox Grid.Row="0" Grid.Column="2" Padding="6,4"
                                             Text="{Binding Prize, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Description" VerticalAlignment="Center" Width="70" />
                                    <TextBox Grid.Row="2" Grid.Column="2" Padding="6,4"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- New testdata -->
                        <Border Background="#F5F5F5" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Nuevo:" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,8,0" />
                                <TextBox DockPanel.Dock="Left" Width="220" Padding="6,4" VerticalContentAlignment="Center"
                                         Text="{Binding NewFileName, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nombre del nuevo testdata (ej. 101852_X200.testdata)" />
                                <Button DockPanel.Dock="Left" Content="Crear con el contenido del editor" Padding="10,4" Margin="8,0,0,0"
                                        Command="{Binding CreateFileCommand}" />
                            </DockPanel>
                        </Border>

                        <TextBlock Foreground="#1565C0" FontSize="11" Margin="0,8,0,0"
                                   Text="Contenido decodificado de Base64 — se re-codifica al guardar."
                                   Visibility="{Binding IsDecodedFromBase64, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource ErrorText}" Margin="0,8,0,6"
                                   Text="{Binding ErrorMessage}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                    <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="8" Background="#FAFAFA" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
