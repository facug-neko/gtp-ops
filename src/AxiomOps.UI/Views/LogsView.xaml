<UserControl x:Class="AxiomOps.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AxiomOps.UI.Converters">
    <UserControl.Resources>
        <conv:LogSeverityToForegroundConverter x:Key="SeverityToForeground" />
        <conv:LogSeverityToBackgroundConverter x:Key="SeverityToBackground" />
        <conv:LogSeverityToAccentConverter x:Key="SeverityToAccent" />
        <conv:BoolToTextWrappingConverter x:Key="BoolToWrapping" />

        <!-- One log line: colour bar + line number + monospaced text -->
        <DataTemplate x:Key="LogLineTemplate">
            <Border Background="{Binding Severity, Converter={StaticResource SeverityToBackground}}"
                    BorderBrush="{Binding Severity, Converter={StaticResource SeverityToAccent}}"
                    BorderThickness="3,0,0,0" Padding="0,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Number}" Width="52" Margin="4,0,8,0"
                               TextAlignment="Right" Foreground="#BDBDBD" />
                    <TextBlock Grid.Column="1" Text="{Binding Text}"
                               Foreground="{Binding Severity, Converter={StaticResource SeverityToForeground}}"
                               TextWrapping="{Binding DataContext.WordWrap, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToWrapping}}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Visor de logs" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Foreground="#757575" Margin="0,4,0,0">
                    <Run Text="Ambiente:" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="  ·  archivos .log del appliance" />
                </TextBlock>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="← Volver" Padding="12,6" Command="{Binding BackCommand}" />
        </DockPanel>

        <!-- Folder path + reload -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Carpeta:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#757575" />
            <Button DockPanel.Dock="Right" Content="⟳ Recargar carpeta" Padding="12,6" Margin="8,0,0,0"
                    Command="{Binding ReloadFolderCommand}" />
            <TextBox Text="{Binding LogFolderPath, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center" Padding="6,4" FontFamily="Consolas" />
        </DockPanel>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0" Margin="0,0,0,4"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="3" Style="{StaticResource ErrorText}" Margin="0,0,0,6"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

        <!-- Files (left) + viewer (right) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- File list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Archivos .log" FontWeight="SemiBold" Margin="12,12,12,6" />
                    <CheckBox DockPanel.Dock="Top" Content="Solo Veyron" IsChecked="{Binding VeyronOnly}"
                              Margin="12,0,12,6"
                              ToolTip="Muestra solo los archivos con 'Veyron' en el nombre — donde suelen caer los errores" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Foreground="#9E9E9E"
                               FontSize="11" Margin="12,0,12,6" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,4" ToolTip="{Binding Name}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DateModified, StringFormat='yyyy-MM-dd HH:mm'}"
                                               Foreground="#9E9E9E" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Viewer -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <!-- Toolbar -->
                    <Border DockPanel.Dock="Top" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,8">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <!-- Counts -->
                                <Border DockPanel.Dock="Right" Background="#FDECEA" CornerRadius="4" Padding="8,3" Margin="6,0,0,0">
                                    <TextBlock>
                                        <Run Text="{Binding ErrorCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#C62828" />
                                        <Run Text="errores" Foreground="#C62828" />
                                    </TextBlock>
                                </Border>
                                <Border DockPanel.Dock="Right" Background="#FFF8E1" CornerRadius="4" Padding="8,3" Margin="6,0,0,0">
                                    <TextBlock>
                                        <Run Text="{Binding WarningCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#8D6E00" />
                                        <Run Text="warnings" Foreground="#8D6E00" />
                                    </TextBlock>
                                </Border>
                                <!-- Search -->
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         VerticalContentAlignment="Center" Padding="6,4"
                                         ToolTip="Filtrar líneas que contengan este texto" />
                            </DockPanel>
                            <DockPanel Margin="0,8,0,0" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="Mostrar:" VerticalAlignment="Center"
                                           Foreground="#757575" Margin="0,0,8,0" />
                                <ComboBox DockPanel.Dock="Left" Width="170" ItemsSource="{Binding FilterModes}"
                                          SelectedItem="{Binding FilterMode}" VerticalContentAlignment="Center">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Todo" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="ProblemsOnly">
                                                                <Setter Property="Text" Value="Errores y warnings" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="ErrorsOnly">
                                                                <Setter Property="Text" Value="Solo errores" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <CheckBox DockPanel.Dock="Left" Content="Ajustar línea" IsChecked="{Binding WordWrap}"
                                          VerticalAlignment="Center" Margin="14,0,0,0" />
                                <CheckBox DockPanel.Dock="Left" Content="Auto-actualizar (5s)" IsChecked="{Binding AutoRefresh}"
                                          VerticalAlignment="Center" Margin="14,0,0,0"
                                          ToolTip="Relee el archivo cada 5 segundos y salta al final" />
                                <Button DockPanel.Dock="Right" Content="⧉ Copiar" Padding="10,4" Margin="6,0,0,0"
                                        Command="{Binding CopyContentCommand}"
                                        ToolTip="Copia las líneas visibles al portapapeles" />
                                <Button DockPanel.Dock="Right" Content="⟳ Recargar" Padding="10,4"
                                        Command="{Binding RefreshContentCommand}"
                                        ToolTip="Vuelve a leer el archivo y salta al final" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Summary line -->
                    <Border DockPanel.Dock="Bottom" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="10,5">
                        <TextBlock Foreground="#757575" FontSize="12">
                            <Run Text="{Binding ShownLines, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="de" />
                            <Run Text="{Binding TotalLines, Mode=OneWay}" />
                            <Run Text="líneas visibles" />
                            <Run Text="   ·   " />
                            <Run Text="{Binding FileSummary, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <!-- Lines -->
                    <ListBox x:Name="LinesList" ItemsSource="{Binding Lines}"
                             ItemTemplate="{StaticResource LogLineTemplate}"
                             FontFamily="Consolas" FontSize="12"
                             BorderThickness="0" Background="White"
                             SelectionMode="Extended"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
