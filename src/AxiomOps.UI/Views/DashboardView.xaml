<UserControl x:Class="AxiomOps.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold">
                    <Run Text="Ambiente:" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="#757575" Margin="0,4,0,0"
                           Text="{Binding State.ApplianceMetaData.EnvironmentName, TargetNullValue=''}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="🚀 Deploy" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenDeployGameCommand}" />
                <Button Content="▶ Launch" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenLaunchToolCommand}" />
                <Button Content="🎮 Juegos" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenGamesToolCommand}" />
                <Button Content="📁 Archivos" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenFilesToolCommand}" />
                <Button Content="📄 Logs" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenLogsToolCommand}" />
                <Button Content="🧪 TestData" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenTestDataToolCommand}" />
                <Button Content="👤 Usuarios" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenUsersToolCommand}" />
                <Button Content="🎲 Bet settings masivos" Padding="12,6" Margin="0,0,8,0"
                        FontWeight="SemiBold"
                        Command="{Binding OpenBetSettingsToolCommand}" />
                <Button Content="⟳ Actualizar" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <Button Content="🔌 Cambiar ambiente" Padding="12,6"
                        Command="{Binding ChangeEnvironmentCommand}" />
            </StackPanel>
        </DockPanel>

        <ProgressBar Grid.Row="1" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsLoadingBasics, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="2" Margin="0,8,0,0" Style="{StaticResource ErrorText}"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />

        <!-- Summary cards -->
        <UniformGrid Grid.Row="3" Columns="4" Margin="0,10,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Salud del appliance" />
                    <TextBlock Style="{StaticResource CardValue}"
                               Text="{Binding HealthLabel}"
                               Foreground="{Binding IsHealthy, Converter={StaticResource HealthToBrush}}" />
                    <TextBlock Foreground="#9E9E9E" FontSize="11" Margin="0,4,0,0"
                               Text="El chequeo tarda ~35 s en el server; corre en segundo plano."
                               TextWrapping="Wrap"
                               Visibility="{Binding IsLoadingHealth, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Juegos instalados" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding InstalledGamesCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Hosts" />
                    <TextBlock Style="{StaticResource CardValue}" Text="{Binding HostCount}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Última provisión" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                               Text="{Binding LastProvision}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Detail: (hosts + games) / services / app pools — three equal columns -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Failures banner (only when unhealthy) -->
            <Border Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,12"
                    Background="#FDECEA" BorderBrush="#F5C6CB" BorderThickness="1" CornerRadius="6" Padding="12">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHealthy}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="Fallas detectadas" FontWeight="SemiBold" Foreground="#C62828" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#7F1D1D" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Left column: compact hosts + installed games -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hosts (compact) -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Hosts" FontWeight="SemiBold" Margin="14,12,14,6" />
                        <DataGrid ItemsSource="{Binding Hosts}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Host" Width="*" Binding="{Binding HostName}" />
                                <DataGridTextColumn Header="IP" Width="130" Binding="{Binding IpAddress}" />
                                <DataGridTemplateColumn Header="Salud" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="●" HorizontalAlignment="Center"
                                                       Foreground="{Binding IsHealthy, Converter={StaticResource HealthToBrush}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="CPU" Width="80" Binding="{Binding CpuUsed}" />
                                <DataGridTextColumn Header="RAM" Width="80" Binding="{Binding RamUsed}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Installed games -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Juegos instalados" FontWeight="SemiBold" Margin="14,12,14,6" />
                        <DataGrid ItemsSource="{Binding InstalledGames}"
                                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                  BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Módulo" Width="80" Binding="{Binding ModuleId}" />
                                <DataGridTextColumn Header="Cliente" Width="80" Binding="{Binding ClientId}" />
                                <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding DisplayName}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Services (full-height column) -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Servicios" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" Foreground="#757575" FontSize="12"
                                       VerticalAlignment="Center" Text="{Binding ServicesSummary}" />
                            <Button DockPanel.Dock="Right" Content="⟳" Padding="8,2" FontWeight="SemiBold"
                                    ToolTip="Recargar solo los servicios"
                                    Command="{Binding RefreshServicesCommand}" />
                            <ProgressBar DockPanel.Dock="Right" Width="70" Height="4" Margin="0,0,10,0"
                                         IsIndeterminate="True" BorderThickness="0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoadingServices, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="▶ Iniciar todos" Padding="10,4" Margin="0,0,8,6" FontWeight="SemiBold"
                                    Background="#2E7D32" Foreground="White"
                                    ToolTip="Inicia todos los servicios detenidos"
                                    Command="{Binding StartAllServicesCommand}" />
                            <Button Content="■ Detener todos" Padding="10,4" Margin="0,0,8,6"
                                    ToolTip="Detiene todos los servicios corriendo (pide confirmación)"
                                    Command="{Binding StopAllServicesCommand}" />
                            <Button Content="▶ Iniciar Veyron" Padding="10,4" Margin="0,0,8,6" FontWeight="SemiBold"
                                    Background="#1565C0" Foreground="White"
                                    ToolTip="Inicia los servicios cuyo nombre contiene 'veyron'"
                                    Command="{Binding StartVeyronServicesCommand}" />
                            <Button Content="■ Detener Veyron" Padding="10,4" Margin="0,0,8,6"
                                    ToolTip="Detiene los servicios cuyo nombre contiene 'veyron' — para subir el service de un juego"
                                    Command="{Binding StopVeyronServicesCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Services}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Estado" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="●" Margin="0,0,6,0"
                                                       Foreground="{Binding IsRunning, Converter={StaticResource HealthToBrush}}" />
                                            <TextBlock Text="{Binding State}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Servicio" Width="*" Binding="{Binding Name}">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="ToolTip" Value="{Binding Description}" />
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Host" Width="70" Binding="{Binding HostName}" />
                            <DataGridTemplateColumn Header="Acción" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Button Content="Iniciar" Padding="8,3" FontWeight="SemiBold"
                                                    Background="#2E7D32" Foreground="White"
                                                    Command="{Binding DataContext.StartServiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
                                            <Button Content="Detener" Padding="8,3"
                                                    Command="{Binding DataContext.StopServiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Application pools (full-height column) -->
            <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,6">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="Application pools" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="⟳" Padding="8,2" FontWeight="SemiBold"
                                    ToolTip="Recargar solo los application pools"
                                    Command="{Binding RefreshAppPoolsCommand}" />
                            <ProgressBar DockPanel.Dock="Right" Width="70" Height="4" Margin="0,0,10,0"
                                         IsIndeterminate="True" BorderThickness="0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoadingAppPools, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>
                        <TextBlock Foreground="#757575" FontSize="12" Margin="0,2,0,0"
                                   Text="{Binding AppPoolsSummary}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="▶ Iniciar todos" Padding="10,4" Margin="0,0,8,6" FontWeight="SemiBold"
                                    Background="#2E7D32" Foreground="White"
                                    ToolTip="Inicia todos los app pools detenidos"
                                    Command="{Binding StartAllAppPoolsCommand}" />
                            <Button Content="■ Detener todos" Padding="10,4" Margin="0,0,8,6"
                                    ToolTip="Detiene todos los app pools iniciados (pide confirmación)"
                                    Command="{Binding StopAllAppPoolsCommand}" />
                            <Button Content="♲ Reciclar todos" Padding="10,4" Margin="0,0,8,6" FontWeight="SemiBold"
                                    Background="#EF6C00" Foreground="White"
                                    ToolTip="Recicla todos los app pools iniciados (pide confirmación)"
                                    Command="{Binding RecycleAllAppPoolsCommand}" />
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding AppPools}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Estado" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="●" Margin="0,0,6,0"
                                                       Foreground="{Binding IsStarted, Converter={StaticResource HealthToBrush}}" />
                                            <TextBlock Text="{Binding Status}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStarted}" Value="False">
                                                                <Setter Property="Foreground" Value="#C62828" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="App pool" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Host" Width="60" Binding="{Binding HostName}" />
                            <DataGridTemplateColumn Header="Acción" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid>
                                                <Button Content="Iniciar" Padding="8,3" FontWeight="SemiBold"
                                                        Background="#2E7D32" Foreground="White"
                                                        Command="{Binding DataContext.StartAppPoolCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsStarted, Converter={StaticResource InverseBoolToVisibility}}" />
                                                <Button Content="Detener" Padding="8,3"
                                                        Command="{Binding DataContext.StopAppPoolCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsStarted, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                            <Button Content="Reciclar" Padding="8,3" Margin="6,0,0,0"
                                                    Background="#EF6C00" Foreground="White" FontWeight="SemiBold"
                                                    ToolTip="Recicla el app pool"
                                                    Command="{Binding DataContext.RecycleAppPoolCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
