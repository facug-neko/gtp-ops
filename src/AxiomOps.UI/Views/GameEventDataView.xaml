<UserControl x:Class="AxiomOps.UI.Views.GameEventDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="XmlBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="#FAFAFA" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold">
                    <Run Text="Jugadas —" /> <Run Text="{Binding LoginName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="#757575" Margin="0,4,0,0">
                    <Run Text="UserId:" /> <Run Text="{Binding UserId, Mode=OneWay}" />
                    <Run Text="  ·  EventData, GameState y StatsData de cada evento." />
                </TextBlock>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="⟳ Actualizar" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <Button Content="← Volver a usuarios" Padding="12,6"
                        Command="{Binding BackCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="300" Padding="6,5" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtrar por transacción, tipo de evento o contenido del XML" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#757575"
                       Text="{Binding StatusMessage}" />
        </DockPanel>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <!-- The list has fixed-size content; cap it so the XML viewer absorbs
                     all the extra space when the window is maximized. -->
                <ColumnDefinition Width="3*" MinWidth="380" MaxWidth="560" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <!-- Event list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Margin="14,10,14,0"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Trans." Width="65" Binding="{Binding TransactionNumber}" />
                            <DataGridTextColumn Header="Evt" Width="45" Binding="{Binding EventNumber}" />
                            <DataGridTextColumn Header="Tipo" Width="*" MinWidth="130" Binding="{Binding EventKind}" />
                            <DataGridTextColumn Header="Hora" Width="145" MinWidth="145"
                                                Binding="{Binding TransactionTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Payloads -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <TabControl BorderThickness="0" Background="Transparent" Margin="6">
                    <TabItem Header="Event Data">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Content="Copiar" Padding="10,4" Margin="0,6,0,6"
                                    HorizontalAlignment="Left" Command="{Binding CopyEventDataCommand}" />
                            <TextBox Style="{StaticResource XmlBox}" Text="{Binding SelectedRow.EventData, Mode=OneWay}" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Game State">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Content="Copiar" Padding="10,4" Margin="0,6,0,6"
                                    HorizontalAlignment="Left" Command="{Binding CopyGameDataCommand}" />
                            <TextBox Style="{StaticResource XmlBox}" Text="{Binding SelectedRow.GameData, Mode=OneWay}" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Stats Data">
                        <DockPanel>
                            <Button DockPanel.Dock="Top" Content="Copiar" Padding="10,4" Margin="0,6,0,6"
                                    HorizontalAlignment="Left" Command="{Binding CopyStatsDataCommand}" />
                            <TextBox Style="{StaticResource XmlBox}" Text="{Binding SelectedRow.StatsData, Mode=OneWay}" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
