<UserControl x:Class="AxiomOps.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold">
                    <Run Text="Usuarios —" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="#757575" Margin="0,4,0,0"
                           Text="Seleccioná un usuario para ver sus acciones disponibles." />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="➕ Crear usuario" Padding="12,6" Margin="0,0,8,0" FontWeight="SemiBold"
                        Command="{Binding CreateUserCommand}" />
                <Button Content="⟳ Actualizar" Padding="12,6" Margin="0,0,8,0"
                        Command="{Binding RefreshCommand}" />
                <Button Content="← Volver al dashboard" Padding="12,6"
                        Command="{Binding BackCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <TextBox DockPanel.Dock="Left" Width="300" Padding="6,5" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtrar por loginName, username o userId" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#757575"
                       Text="{Binding StatusMessage}" />
        </DockPanel>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- User list -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ErrorText}" Margin="14,10,14,0"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              SelectionMode="Single" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" Background="Transparent" RowBackground="Transparent"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UserId" Width="90" Binding="{Binding UserId}" />
                            <DataGridTextColumn Header="Login" Width="*" Binding="{Binding LoginName}" />
                            <DataGridTextColumn Header="Producto" Width="150" Binding="{Binding ProductName}" />
                            <DataGridTextColumn Header="Mercado" Width="110" Binding="{Binding RegulatedMarketIsoCode}" />
                            <DataGridTextColumn Header="Moneda" Width="80" Binding="{Binding CurrencyIsoCode}" />
                            <DataGridTextColumn Header="Balance" Width="110"
                                                Binding="{Binding Balance, Converter={StaticResource CentsToUnits}, StringFormat=N2}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Actions panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Usuario seleccionado" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock FontSize="15" FontWeight="SemiBold"
                                       Text="{Binding SelectedUser.LoginName, TargetNullValue=—}" />
                            <TextBlock Foreground="#757575" FontSize="12" Margin="0,4,0,0">
                                <Run Text="UserId:" /> <Run Text="{Binding SelectedUser.UserId, Mode=OneWay}" />
                                <Run Text="   Producto:" /> <Run Text="{Binding SelectedUser.ProductName, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Foreground="#757575" FontSize="12" Margin="0,2,0,0">
                                <Run Text="Balance actual:" />
                                <Run Text="{Binding SelectedUser.Balance, Mode=OneWay, Converter={StaticResource CentsToUnits}, StringFormat=N2}" FontWeight="SemiBold" />
                                <Run Text="{Binding SelectedUser.CurrencyIsoCode, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Action: view plays -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            IsEnabled="{Binding HasSelection}">
                        <StackPanel>
                            <TextBlock Text="Jugadas del usuario" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Button Content="🔍 Ver EventData / GameState / StatsData" Padding="0,8" FontWeight="SemiBold"
                                    Command="{Binding ViewPlaysCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Action: quick launch -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            IsEnabled="{Binding HasSelection}">
                        <StackPanel>
                            <TextBlock Text="Launch rápido" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Juego" />
                            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedLaunchGame}"
                                      Padding="6,5" Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                            <Run Foreground="#757575">
                                                <Run.Text>
                                                    <MultiBinding StringFormat="  [{0}/{1}]" Mode="OneWay">
                                                        <Binding Path="ModuleId" Mode="OneWay" />
                                                        <Binding Path="ClientId" Mode="OneWay" />
                                                    </MultiBinding>
                                                </Run.Text>
                                            </Run>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Versión (última precargada)" />
                            <ComboBox ItemsSource="{Binding LaunchGameVersions}"
                                      SelectedItem="{Binding SelectedLaunchGameVersion}"
                                      Padding="6,5" Margin="0,0,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="▶ Launch" Padding="0,8" FontWeight="SemiBold"
                                        Background="#2E7D32" Foreground="White"
                                        Command="{Binding LaunchGameCommand}" />
                                <Button Grid.Column="2" Content="🕶 Incógnito" Padding="0,8" FontWeight="SemiBold"
                                        Background="#37474F" Foreground="White"
                                        Command="{Binding LaunchGameIncognitoCommand}" />
                            </Grid>
                            <TextBlock Margin="0,8,0,0" Foreground="#9E9E9E" FontSize="11" TextWrapping="Wrap"
                                       Text="Defaults: mercado DotCom · idioma en · host desktop · Titan última versión · password test1234$" />
                        </StackPanel>
                    </Border>

                    <!-- Action: set balance -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            IsEnabled="{Binding HasSelection}">
                        <StackPanel>
                            <TextBlock Text="Aplicar balance" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Monto" />
                            <TextBox Padding="6,5" FontFamily="Consolas" Margin="0,0,0,10"
                                     Text="{Binding BalanceAmount, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="En unidades de la moneda, con punto decimal: 10000 deja el balance en 10,000.00" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="ServerId (precargado con el productId del usuario)" />
                            <TextBox Padding="6,5" FontFamily="Consolas" Margin="0,0,0,12"
                                     Text="{Binding ServerId, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Aplicar balance" Padding="0,8" FontWeight="SemiBold"
                                    Background="#1565C0" Foreground="White"
                                    Command="{Binding ApplyBalanceCommand}" />
                        </StackPanel>
                    </Border>

                    <!-- Action: close game sessions -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0"
                            IsEnabled="{Binding HasSelection}">
                        <StackPanel>
                            <TextBlock Text="Cerrar sesiones de juego" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="Juego" />
                            <ComboBox ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedSessionGame}"
                                      Padding="6,5" Margin="0,0,0,10">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding DisplayName, Mode=OneWay}" />
                                            <Run Foreground="#757575">
                                                <Run.Text>
                                                    <MultiBinding StringFormat="  [{0}/{1}]" Mode="OneWay">
                                                        <Binding Path="ModuleId" Mode="OneWay" />
                                                        <Binding Path="ClientId" Mode="OneWay" />
                                                    </MultiBinding>
                                                </Run.Text>
                                            </Run>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="Cerrar sesión del juego" Padding="0,8" FontWeight="SemiBold"
                                    Background="#1565C0" Foreground="White"
                                    Command="{Binding CloseSessionCommand}" />
                            <Button Content="Cerrar en todos los juegos" Padding="0,6" Margin="0,8,0,0"
                                    Command="{Binding CloseAllSessionsCommand}"
                                    ToolTip="Ejecuta el cierre de sesión del usuario en cada juego instalado del ambiente." />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="2,12,0,0" Foreground="#2E7D32" TextWrapping="Wrap"
                               Text="{Binding ActionMessage}"
                               Visibility="{Binding ActionMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Margin="2,12,0,0" Style="{StaticResource ErrorText}"
                               Text="{Binding ActionError}"
                               Visibility="{Binding ActionError, Converter={StaticResource NullOrEmptyToVisibility}}" />

                    <TextBlock Margin="2,14,0,0" Foreground="#9E9E9E" FontSize="12" TextWrapping="Wrap"
                               Text="Próximas acciones (cambiar moneda, session reminder, migrar a LVCS) se agregan en este panel." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
