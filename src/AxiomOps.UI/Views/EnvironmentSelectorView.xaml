<UserControl x:Class="AxiomOps.UI.Views.EnvironmentSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Seleccionar ambiente" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Ambientes obtenidos vía Compass (compass portal get-environments). La api-key es la de Axiom Admin del ambiente."
                       Foreground="#757575" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="⟳ Recargar"
                    Command="{Binding LoadEnvironmentsCommand}"
                    Padding="12,6" Margin="0,0,10,0" />
            <TextBox DockPanel.Dock="Left" Width="260" Padding="6,5" VerticalContentAlignment="Center"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Filtrar por nombre" />
            <CheckBox DockPanel.Dock="Left" Content="Solo Axiom" IsChecked="{Binding AxiomOnly}"
                      VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Environments + connection panel -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <ListView ItemsSource="{Binding Environments}"
                          SelectedItem="{Binding SelectedEnvironment}"
                          BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Interno" Width="130" DisplayMemberBinding="{Binding InternalName}" />
                            <GridViewColumn Header="Nombre" Width="280" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Tipo" Width="110" DisplayMemberBinding="{Binding Type}" />
                            <GridViewColumn Header="Versión" Width="120" DisplayMemberBinding="{Binding EnvironmentVersion}" />
                            <GridViewColumn Header="Estado" Width="110" DisplayMemberBinding="{Binding Status}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Conexión" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Style="{StaticResource CardTitle}" Text="Ambiente" />
                    <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                               Text="{Binding SelectedEnvironment.InternalName, TargetNullValue=—}" />

                    <TextBlock Style="{StaticResource CardTitle}" Text="URL" />
                    <TextBlock Foreground="#616161" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="12"
                               Text="{Binding SelectedEnvironment.AxiomCoreBaseUrl, TargetNullValue=—}" />

                    <TextBlock Style="{StaticResource CardTitle}" Text="Api-key (x-api-key de Axiom Admin)" />
                    <TextBox Padding="6,5" Margin="0,0,0,12" FontFamily="Consolas"
                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Content="Conectar" Padding="0,8" FontWeight="SemiBold"
                            Command="{Binding ConnectCommand}" />

                    <Button Content="🔄 Reboot ambiente" Padding="0,8" Margin="0,8,0,0"
                            Background="#C62828" Foreground="White"
                            ToolTip="Reinicia todos los servicios del ambiente (compass portal reboot-appliance) — interrumpe sesiones y jugadas activas"
                            Command="{Binding RebootCommand}" />

                    <TextBlock Margin="0,12,0,0" Foreground="#2E7D32" TextWrapping="Wrap"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource ErrorText}"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,10,0,0" Foreground="#9E9E9E" FontSize="12"
                   Text="Requisito: compass CLI instalado y sesión iniciada (compass login). Las keys se guardan en ~/.axiom-compass/keys.json (compartido con axiom-compass)." />
    </Grid>
</UserControl>
