<UserControl x:Class="AxiomOps.UI.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AxiomOps.Services.Models;assembly=AxiomOps.Services">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type models:FileFolderNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Margin="0,0,6,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="📄" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ObjectType}" Value="Folder">
                                    <Setter Property="Text" Value="📁" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ObjectType}" Value="Directory">
                                    <Setter Property="Text" Value="📁" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" />
                <TextBlock Text="{Binding DateModified, StringFormat=' — {0:yyyy-MM-dd HH:mm}'}"
                           Foreground="#9E9E9E" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="24" FontWeight="SemiBold">
                    <Run Text="Archivos —" /> <Run Text="{Binding EnvironmentName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Foreground="#757575" Margin="0,4,0,0"
                           Text="Explorá las carpetas gestionables del ambiente, mirá y editá archivos de texto, o eliminá archivos y carpetas." />
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="← Volver al dashboard" Padding="12,6" VerticalAlignment="Top"
                    Command="{Binding BackCommand}" />
        </DockPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Carpeta:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox DockPanel.Dock="Left" Width="420" Padding="6,5"
                      ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Value}" FontFamily="Consolas" FontSize="12" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button DockPanel.Dock="Left" Content="⟳" Padding="10,4" Margin="8,0,0,0"
                    ToolTip="Recargar el árbol" Command="{Binding LoadTreeCommand}" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#757575"
                       Text="{Binding StatusMessage}" />
        </DockPanel>

        <ProgressBar Grid.Row="2" Height="4" IsIndeterminate="True" BorderThickness="0"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- Tree -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="4">
                <TreeView x:Name="Tree" ItemsSource="{Binding Nodes}" BorderThickness="0"
                          SelectedItemChanged="Tree_SelectedItemChanged"
                          VirtualizingPanel.IsVirtualizing="True" />
            </Border>

            <!-- Detail / editor -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                                   Text="{Binding SelectedNode.Path, TargetNullValue='Seleccioná un archivo o carpeta del árbol'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Button Content="Ver contenido" Padding="10,5" FontWeight="SemiBold"
                                    Background="#1565C0" Foreground="White"
                                    Command="{Binding OpenFileCommand}" />
                            <Button Content="💾 Guardar cambios" Padding="10,5" Margin="8,0,0,0" FontWeight="SemiBold"
                                    Background="#2E7D32" Foreground="White"
                                    Command="{Binding SaveFileCommand}" />
                            <Button Content="🗑 Eliminar archivo" Padding="10,5" Margin="8,0,0,0"
                                    Command="{Binding DeleteFileCommand}"
                                    Visibility="{Binding IsFileSelected, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="🗑 Eliminar carpeta" Padding="10,5" Margin="8,0,0,0"
                                    Command="{Binding DeleteFolderCommand}"
                                    Visibility="{Binding IsFolderSelected, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Foreground="#1565C0" FontSize="11" Margin="0,0,0,6"
                                   Text="Contenido decodificado de Base64 — se re-codifica al guardar."
                                   Visibility="{Binding IsDecodedFromBase64, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                                   Text="{Binding ErrorMessage}"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibility}}" />
                    </StackPanel>
                    <TextBox Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Padding="8" Background="#FAFAFA" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
